        "--no-daemon",
        "--max-workers=1",
        "runClient2"
      ],
      "windows": {
        "command": ".\\gradlew.bat"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Run: Server",
      "type": "shell",
      "command": "./gradlew",
      "args": [
        "--no-daemon",
        "--max-workers=1",
        "runServer"
      ],
      "windows": {
        "command": ".\\gradlew.bat"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Check: Localization",
      "type": "shell",
      "command": "./gradlew validateAndFormatLocalization",
