{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run: Client 1",
      "type": "shell",
      "command": "./gradlew",
      "args": [
        "--no-daemon",
        "--max-workers=1",
        "runClient"
      ],
      "windows": {
        "command": ".\\gradlew.bat"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Run: Client 2",
      "type": "shell",
      "command": "./gradlew",
