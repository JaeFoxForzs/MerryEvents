{
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.compile.nullAnalysis.mode": "disabled",
  "java.server.launchMode": "LightWeight",
  "java.cleanup.actions": ["qualifyMembers", "qualifyStaticMembers"],
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx1G -Xms128m",
  "files.exclude": {
    "**/.git": true,
    "**/.gradle": true,
    "**/build": true,
    "**/.loom-cache": true,
    "bin/": true,
    "**/*.launch": true,
    "**/*.project": true,
    "**/*.classpath": true,
    "**/__pycache__/": true,
    "**/*.gz": true,
    "run*/screenshots": true,
    "run*/resourcepacks": true,
    "run*/resources": true,
  }
}
